# ---------- Database ----------
# Easiest free option: https://neon.tech (Postgres, works with Vercel/Railway/Render)
# Create a project, copy the "Connection string" (pooled) into DATABASE_URL.
postgresql://neondb_owner:npg_HTf3hKQRSZ9t@ep-hidden-star-aw7oh4kz.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="+cUYP5VNc0sTB4i9DQSTAQzs7WXFt75uHOh63Dg2h9A="
# Your deployed URL. Use http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# ---------- Google OAuth ----------
# https://console.cloud.google.com/apis/credentials
# Create OAuth Client ID (type: Web application)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- GitHub OAuth ----------
# https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------- Email (Resend) ----------
# https://resend.com -> API Keys. Free tier is enough to start.
# Verify a sending domain (or use their onboarding@resend.dev for testing).
RESEND_API_KEY=""
EMAIL_FROM="NAHVI <notifications@yourdomain.com>"

# Where admin notifications are sent. Matches the brief's requirement.
ADMIN_NOTIFY_EMAIL="abhinaypandey675@gmail.com"

# ---------- Rate limiting (optional but recommended) ----------
# Free tier: https://upstash.com (Redis). Leave blank to fall back to
# an in-memory limiter (fine for a single server instance, not for serverless
# multi-region deploys like Vercel — set these up before you get real traffic).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
